# ---- 密钥：私钥永不进 git（keys/README.md 与公钥可以提交） ----
# 全局兜底：任何 *.pem 都忽略；只放行公开公钥
*.pem
!keys/shell_public.pem

# ---- 构建产物 ----
/dist/
/obj/
# 并行会话的隔离产物（build.ps1 -ObjDir/-DistDir）
/.obj-*/
/.dist-*/
/serial-*.log
*.img
*.o
*.bin
*.elf
*.map

# ---- 交叉工具链：约 3.5GB，按 README 自备或使用仓库外副本 ----
# 忽略工具链目录，但保留 tools/ 下的宿主脚本（构建/测试要用）
/tools/*
!/tools/*.ps1
# 提交守卫入口（tools/githooks/pre-commit 是 bash 脚本）必须被跟踪，否则 hook 装不上
!/tools/githooks/

# ---- 运行时 / 调试产物 ----
/*.log
/logs/
/.soak-smp/
/stress-*/
/soak-run/
/serial.log
/test-run.log
/test_net.log
/test_net_serial.log
/t.log
/gdb.txt
/*.ppm
/test_runs_*/
/.acl-recovery/

# ---- 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store

# session coordination artifacts
/.session/

# 旧项目副本（误入仓库，已清理）
/OS/
